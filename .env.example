NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexus_devsuite
DB_USER=root
DB_PASSWORD=Zaq1029*
DB_SKIP_AUTH_ON_STARTUP=false

# Seguridad JWT (obligatorias en no-development con secretos robustos)
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MASTER_EMAIL=master@nexus.local
MASTER_PASSWORD=Master123!

# CORS (development: puede usar "*"; no-development: lista explicita separada por comas)
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Origen del API solo para el proxy de Vite (npm run dev:stack). No afecta el bundle del cliente.
# NEXUS_DEV_API_ORIGIN=http://localhost:3000

# Rate limiting: ventana 15 min (solo cuando NODE_ENV no es development ni test).
# En development/test el limite global esta desactivado por defecto (login/Vite/proxies).
# Para probar 429 en local: RATE_LIMIT_IN_DEV=true (y opcionalmente RATE_LIMIT_MAX bajo).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# PELIGROSO (solo DEV): habilita endpoint para limpiar datos dummy de BD.
# Requiere además header de confirmación en el request.
DEV_DATA_RESET_ENABLED=false
# RATE_LIMIT_IN_DEV=false

# Shutdown (timeout máximo de cierre en ms; default 10000)
SHUTDOWN_TIMEOUT_MS=10000

# GitHub Integration (REST API)
# IMPORTANTE: usa un token con permisos mínimos necesarios (p. ej. repo).
GITHUB_ENABLED=false
# Token personal (solo backend). Recomendado: usar PAT con el alcance adecuado.
GITHUB_TOKEN=replace_with_personal_access_token
# Owner de GitHub (usuario u organizacion)
GITHUB_OWNER=replace_with_github_owner
# Nombre del repo (solo nombre). Alternativamente puedes usar GITHUB_REPO="owner/repo".
GITHUB_REPO=replace_with_repo_name
