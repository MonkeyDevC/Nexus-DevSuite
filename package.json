{
  "name": "nexus-devsuite",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MonkeyDevC/Nexus-DevSuite.git"
  },
  "description": "Base operativa de Nexus DevSuite para gestion empresarial certificable.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "install:all": "npm ci && npm ci --prefix frontend-react",
    "start": "node src/server.js",
    "dev": "powershell -ExecutionPolicy Bypass -File dev-clean.ps1",
    "dev:server": "npx nodemon src/server.js",
    "dev:vite": "npm run dev --prefix frontend-react",
    "dev:stack": "concurrently -k -n api,vite -c blue,magenta \"npm run dev:server\" \"npm run dev:vite\"",
    "build:react": "node scripts/build-react.js",
    "verify:vite-react-node-env": "npm run verify:react-node-env --prefix frontend-react",
    "e2e:server": "node src/server.js",
    "e2e:bootstrap": "npm run build:react && npm run db:migrate && npm run db:seed",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "qa:dia2": "node scripts/qa-dia2.js",
    "db:setup": "node scripts/setup-database.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:clean": "node scripts/clean-dummy-data.js",
    "create-master-user": "node scripts/create-master-user.js",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test tests/e2e/**/*.dev.spec.js --project=chromium",
    "test:e2e:auth-http-bridge": "playwright test tests/e2e/auth-http-refresh-and-legacy-bridge.spec.js --project=chromium",
    "test:e2e:sprints": "playwright test tests/e2e/sprints-lifecycle-workflow.spec.js --project=chromium",
    "test:e2e:incidents": "playwright test tests/e2e/incidents-lifecycle-workflow.spec.js --project=chromium",
    "test:e2e:releases": "playwright test tests/e2e/releases-assign-and-publish-workflow.spec.js --project=chromium",
    "validate:openapi": "node scripts/validate-openapi.js"
  },
  "keywords": [
    "nexus",
    "devsuite",
    "express",
    "sequelize",
    "iso9001"
  ],
  "author": "Nexus DevSuite Team",
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "htmlparser2": "^10.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sequelize": "^6.37.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.1.2",
    "eslint": "^10.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "forceExit": true,
    "setupFiles": [
      "<rootDir>/src/tests/jest/jest.env.js"
    ],
    "globalSetup": "<rootDir>/src/tests/jest/jest.globalSetup.js",
    "globalTeardown": "<rootDir>/src/tests/jest/jest.globalTeardown.js",
    "roots": [
      "<rootDir>/src/tests"
    ]
  }
}
